# Copia este archivo a .env y ajusta los valores.
# Desarrollo local: puedes dejar todo vacío (usa SQLite y DEBUG=True).

DEBUG=True
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# PostgreSQL (producción). Si no se define, se usa SQLite.
# DATABASE_URL=postgres://usuario:clave@host:5432/bmcore
# DATABASE_SSL=False

# Pon True cuando el sitio se sirva por HTTPS (cookies seguras).
USE_HTTPS=False

# True para que Django sirva /media/ con DEBUG=False (despliegues pequeños)
SERVE_MEDIA=False

# Solo para docker compose: contraseña de PostgreSQL
POSTGRES_PASSWORD=cambia-esta-clave

# Correo para alertas de stock bajo. Sin estas variables, en DEBUG se imprimen en la consola.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=tu_cuenta@gmail.com
# EMAIL_HOST_PASSWORD=contraseña-de-aplicación
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=BM-Core <tu_cuenta@gmail.com>
